# Copy to .env and fill in your own values. .env is gitignored; never commit it.

# Target tenant: your lab tenant, or a tenant you are authorized in writing to assess.
AZURE_TENANT_ID=<tenant-guid>

# Your own lab tenant. A run against this tenant needs only the run-level (v1)
# consent record; every other tenant needs an active v2 record (G-1, ADR 0008).
# Leave unset to require a v2 record for every tenant.
REJEWSKI_LAB_TENANT_ID=<lab-tenant-guid>

# Borrowed first-party client (ADR 0006): Microsoft Graph Command Line Tools.
FOCI_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e

# The seeded test account the tools sign in as (scripts/seed-lab-tenant.ps1).
COMPROMISED_USER_UPN=<user>@<lab-domain>
COMPROMISED_USER_PASSWORD=<password>

# Operator details for scripts/write_consent_record.py.
REJEWSKI_OPERATOR_OBJECT_ID=<operator-entra-object-id>
REJEWSKI_OPERATOR_NAME=<Your Name (Your Organization)>
REJEWSKI_OPERATOR_EMAIL=<you@your-domain>

# Claude Agent SDK runtime (scripts/rejewski_runtime.py, scripts/reasoning_loop.py).
ANTHROPIC_API_KEY=<your-api-key>
